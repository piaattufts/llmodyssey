VITE_STORAGE_MODE=local
VITE_RESEARCH_MODE=false

# Optional only. Leave blank for the default local install.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional live model calls. The games do not use these.
# Keep vendor keys on a server. Point the app at examples/llm-proxy or your own proxy.
VITE_LLM_PROVIDER=mock
VITE_LLM_PROXY_URL=

# Set to /llmodyssey/ when building for GitHub Pages on piaattufts/llmodyssey.
# VITE_BASE_PATH=/
